<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextField?>

<?import javafx.scene.layout.GridPane?>
<VBox spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="GoannaWatch.observations.controller.ObservationController"
      stylesheets="@observation.css">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <Label text="Record an Observation" id="pageTitle" wrapText="true"/>

    <GridPane hgap="5.0" vgap="5.0" >
        <Label text="Location:" GridPane.columnIndex="0" GridPane.rowIndex="0" />
        <Label text="Animal Seen:" GridPane.columnIndex="0" GridPane.rowIndex="1" />
        <Label text="Date:" GridPane.columnIndex="0" GridPane.rowIndex="2" />
        <TextField fx:id="locationTextField" GridPane.columnIndex="1" GridPane.rowIndex="0" maxWidth="Infinity"/>
        <TextField fx:id="animalTextField" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <DatePicker fx:id="datePicker" GridPane.columnIndex="1" GridPane.rowIndex="2" />
    </GridPane>

    <VBox alignment="CENTER">
        <Button text="Submit" fx:id="submitButton" prefHeight="50" prefWidth="300" onAction="#onSubmitButtonClick"/>
        <Button text="Cancel" fx:id="cancelButton" prefHeight="50" prefWidth="300" onAction="#onCancelButtonClick"/>
    </VBox>
</VBox>


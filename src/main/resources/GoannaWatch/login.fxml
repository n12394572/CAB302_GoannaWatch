<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.PasswordField?>
<VBox spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="GoannaWatch.account.controller.LoginController"
      stylesheets="@account.css">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <Label text="Welcome Back." id="pageTitle" wrapText="true"/>
    <Label text="Sign in to continue recording local wildlife." id="secondaryText" wrapText="true"/>

    <Label id="userInputLabel" text="Email Address"/>
    <TextField id="userInput" fx:id="emailTextField"
               promptText="Enter your email address..." prefHeight="50" prefWidth="100"
    />
    <Label id="userInputLabel" text="Password"/>
    <PasswordField id="userInput" fx:id="passwordField"
                   promptText="Enter your password..." prefHeight="50" prefWidth="100"
    />
    <CheckBox fx:id="rememberMeCheck"
              text="Remember Me"
              onAction="#onRememberMeCheck"
    />
    <VBox alignment="CENTER">
        <Button text="LOG IN" fx:id="loginButton" prefHeight="50" prefWidth="300" onAction="#onNextButtonClick"/>
        <Button text="Go Back" fx:id="cancelButton" prefHeight="50" prefWidth="300" onAction="#onCancelButtonClick"/>
        <HBox alignment="BOTTOM_CENTER">
            <Label text="Don't have an GoannaWatch?               "/>
            <Label text="insert SIGN UP page link here"/>
        </HBox>
    </VBox>
</VBox>

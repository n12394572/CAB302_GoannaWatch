<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" stylesheets="@pageStyling.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/17.0.12" fx:controller="account.controller.SignupController">
    <HBox id="pageContent" prefHeight="91.0" prefWidth="573.0">
        <VBox id="contentContainer" alignment="CENTER_LEFT">
            <Label id="pageContent" prefHeight="56.0" prefWidth="223.0" text="Goanna Watch">
                <font>
                    <Font name="System Bold" size="18.0" />
                </font>
            </Label>
        </VBox>
        <VBox id="contentContainer" alignment="CENTER_RIGHT" prefHeight="86.0" prefWidth="418.0">
            <Label alignment="CENTER" text="Dashboard">
                <font>
                    <Font name="System Bold" size="12.0" />
                </font>
            </Label>
            <Label text="Profile | Log out" />
        </VBox>
    </HBox>

    <GridPane alignment="CENTER" hgap="10" vgap="10">
        <padding>
            <Insets bottom="10" left="25" right="25" top="25" />
        </padding>
        <VBox id="pageContent">
            <Label id="pageTitle" text="Welcome to Goanna Watch!" wrapText="true" />
            <Label id="secondaryText" text="Sign up to begin recording local wildlife." wrapText="true" />
            <Label id="userInputLabel" text="Email Address" />
            <TextField id="userInput" fx:id="emailAddress" prefHeight="30" prefWidth="200" promptText="Enter your email address..." />
            <Label id="userInputLabel" text="Password" />
            <TextField id="userInput" fx:id="passwordSignUp" prefHeight="30" prefWidth="200" promptText="Enter your password..." />
            <Label id="userInputLabel" text="User type" />
            <ChoiceBox id="userInput" fx:id="userType" onShowing="#userTypeChoice" />
            <Button id="submitForm" prefHeight="62.0" prefWidth="411.0" text="SIGN UP" /> <!-- add link to log-in check mechanism later -->
            <HBox alignment="BOTTOM_CENTER">
                <Label id="contentContainer" text="Already have an account? " />
                <Hyperlink id="contentContainer" fx:id="loginRedirect" onAction="#loginRedirectClick" text="LOG IN here" />
            </HBox>
        </VBox>
      <columnConstraints>
         <ColumnConstraints />
      </columnConstraints>
      <rowConstraints>
         <RowConstraints />
      </rowConstraints>
    </GridPane>
</VBox>

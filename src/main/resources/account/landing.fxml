<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>

<VBox alignment="CENTER" spacing="20.0" xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="account.controller.LandingController"
            prefHeight="400.0" prefWidth="600.0">
    <padding>
        <Insets top="40.0" bottom="40.0" left="40.0" right="40.0" />
    </padding>

    <Label fx:id="welcomeLabel" text="Welcome!" style="-fx-font-size: 26px; -fx-font-weight: bold;" />
    <Label fx:id="emailLabel" text="" />

    <Button fx:id="observationButton" text="Record an Observation" prefWidth="160.0" onAction="#onObservationButtonClick" />
    <Button fx:id="logoutButton" text="Log Out" prefWidth="160.0" onAction="#onLogoutButtonClick" />

</VBox>

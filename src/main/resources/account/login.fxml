<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.layout.HBox?>

<?import javafx.scene.control.TextField?>
<VBox spacing="20.0" xmlns:fx="http://javafx.com/fxml"
      fx:controller="account.controller.LoginController"
        stylesheets="@account.css">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0"/>
    </padding>
    <Label text="Welcome Back." id="pageTitle" wrapText="true"/>
    <Label text="Sign in to continue recording local wildlife." id="secondaryText" wrapText="true"/>

    <Label id="userInputLabel" text="Email Address"/>
    <TextField id="userInput" fx:id="emailAddress"
               promptText="Enter your email address..." prefHeight="50" prefWidth="100"
    />
    <Label id="userInputLabel" text="Password"/>
    <TextField id="userInput" fx:id="passwordLogin"
               promptText="Enter your password..." prefHeight="50" prefWidth="100"
    />
    <CheckBox fx:id="rememberMe"
              text="Remember Me"
              onAction="#rememberMeClick"
    />
    <VBox alignment="CENTER">
        <Button text="LOG IN" id="submitForm" prefHeight="50" prefWidth="300"/> <!-- add link to log-in check mechanism later -->
        <HBox alignment="BOTTOM_CENTER">
            <Label text="Don't have an account?               "/>
            <Label text="insert SIGN UP page link here"/>
        </HBox>
    </VBox>
</VBox>
